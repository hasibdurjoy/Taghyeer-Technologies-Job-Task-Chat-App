# ─────────────────────────────────────────────────────────────
# Copy to `.env.local` and adjust if needed. Never commit `.env.local`.
#
# Both variables are OPTIONAL — the app runs with no .env file at all,
# falling back to the hosted API below.
# ─────────────────────────────────────────────────────────────

# Upstream chat API (REST). Must include the `/api` suffix.
NEXT_PUBLIC_API_BASE_URL=https://frontend-task-chatapp.onrender.com/api

# Socket.io origin. NOTE: this is the ROOT origin, with NO `/api` suffix —
# Socket.io serves itself from `/socket.io/`.
NEXT_PUBLIC_SOCKET_URL=https://frontend-task-chatapp.onrender.com
