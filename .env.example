# ─────────────────────────────────────────────────────────────
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# ─────────────────────────────────────────────────────────────

# Upstream chat API (REST). Must include the `/api` suffix.
# Optional — defaults to the hosted deployment below.
NEXT_PUBLIC_API_BASE_URL=https://frontend-task-chatapp.onrender.com/api

# Socket.io origin. NOTE: this is the ROOT origin, with NO `/api` suffix —
# Socket.io serves itself from `/socket.io/`. Optional; defaults as shown.
NEXT_PUBLIC_SOCKET_URL=https://frontend-task-chatapp.onrender.com

# MongoDB — used ONLY for this app's own read-state (unread badges).
# No user, conversation or message data is stored here.
# Optional: leave both blank and the app still runs; unread badges simply
# reset each session instead of persisting.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=parley
